{
  "$comment": "Structural schema for multihog-game-cartridge files. Interpreted by scripts/lib/schema-check.mjs, which supports ONLY this frozen keyword subset: type, required, properties, additionalProperties, items, enum, const, pattern, maxLength, minimum, $ref (local #/$defs/* only). Anything richer (cross-references, marker names, macro rules, key enumerations that self-heal on import) lives in scripts/lib/lint-rules.mjs. NOTE: the extension's import only checks `format`; everything else here guards against silent data loss/backfill.",
  "type": "object",
  "required": ["format", "payload"],
  "properties": {
    "format": { "const": "multihog-game-cartridge" },
    "version": { "const": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "exportedAt": { "type": "string" },
    "payload": {
      "type": "object",
      "properties": {
        "customSyspromptLibrary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "tag", "content"],
            "properties": {
              "id": { "type": "string" },
              "tag": { "type": "string" },
              "content": { "type": "string" },
              "enabled": { "type": "boolean" },
              "icon": { "type": "string" },
              "description": { "type": "string" },
              "origin": { "enum": ["wizard", "unlocked_base"] },
              "baseTag": { "type": "string" }
            }
          }
        },
        "syspromptSectionOrder": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(base|lib):.+$" }
        },
        "syspromptModules": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "npcRelationshipBars": { "type": "boolean" },
        "rngEnabled": { "type": "boolean" },
        "diceFunctionTool": { "type": "boolean" },
        "diceD100Mode": { "type": "boolean" },
        "rngToolD20": { "type": "boolean" },
        "rngToolD100": { "type": "boolean" },
        "rngQueueD20": { "type": "boolean" },
        "rngQueueD100": { "type": "boolean" },
        "use24hTime": { "type": "boolean" },
        "useDdMmYyFormat": { "type": "boolean" },
        "gameSystems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "icon": { "type": "string" },
              "enabled": { "type": "boolean" },
              "needsTracker": { "type": "boolean" },
              "driverTime": { "type": "boolean" },
              "driverGmAnnotation": { "type": "boolean" },
              "driverStatedFact": { "type": "boolean" },
              "effectOwner": { "enum": ["tracker", "gm"] },
              "syspromptLibraryId": { "type": ["string", "null"] },
              "customFieldTag": { "type": ["string", "null"] },
              "description": { "type": "string" },
              "createdAt": { "type": "number" }
            }
          }
        },
        "customFields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tag", "prompt"],
            "properties": {
              "tag": { "type": "string" },
              "label": { "type": "string" },
              "icon": { "type": "string" },
              "prompt": { "type": "string" },
              "template": { "type": "string" },
              "enabled": { "type": "boolean" },
              "renderType": { "type": "string" },
              "rows": { "type": "number" }
            }
          }
        },
        "blockOrder": { "type": "array", "items": { "type": "string" } },
        "modules": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "stockPrompts": { "type": "object", "additionalProperties": { "type": "string" } },
        "systemPromptTemplate": { "type": "string" },
        "portraitNpcSystemPrompt": { "type": "string" },
        "portraitCharacterSystemPrompt": { "type": "string" },
        "portraitLocationSystemPrompt": { "type": "string" },
        "portraitPromptWordTarget": { "type": "number", "minimum": 10 },
        "savedPortraitPromptPresets": { "type": "object" },
        "npcCoreSections": { "type": "array", "items": { "$ref": "#/$defs/coreSection" } },
        "pcCoreSections": { "type": "array", "items": { "$ref": "#/$defs/coreSection" } },
        "npcSectionPresets": { "type": "object" },
        "pcSectionPresets": { "type": "object" },
        "routerSystemPromptTemplate": { "type": "string" },
        "routerModularPromptTemplate": { "type": "string" },
        "routerModules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "tag": { "type": "string" },
              "format": { "type": "string" },
              "instruction": { "type": "string" }
            }
          }
        },
        "routerCustomTags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tag"],
            "properties": {
              "tag": { "type": "string" },
              "instruction": { "type": "string" },
              "format": { "type": "string" }
            }
          }
        },
        "worldProgressionSystemPrompt": { "type": "string" }
      }
    }
  },
  "$defs": {
    "coreSection": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" }
      }
    }
  }
}
